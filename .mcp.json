{
  "mcpServers": {
    "google-sheets": {
      "command": "uvx",
      "args": ["--with", "mcp<2.0.0", "mcp-google-sheets@latest"],
      "env": {
        "CREDENTIALS_PATH": "${CLAUDE_PROJECT_DIR}/google-workspace-access/credentials.json",
        "TOKEN_PATH": "${CLAUDE_PROJECT_DIR}/google-workspace-access/token.json"
      }
    }
  }
}
